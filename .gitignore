# Dependency directories
node_modules/
Client/node_modules/
Server/node_modules/

# Local environment files (crucial for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Terraform - Ignore downloaded modules and states
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
_override.tf
_override.tf.json

# Private SSH Keys (NEVER commit these!)
*.pem
*.key

# Local Kubernetes Secrets (NEVER commit real credentials!)
*secret.real.yaml
*secret.local.yaml


# System Files
.DS_Store
Thumbs.db
